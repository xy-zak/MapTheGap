# Generated artifacts — rebuild with build.py && render.py
out/

# Per-DOI API response cache (OpenAlex / Semantic Scholar); regenerable
cache/

# Per-user Claude Code settings. The skills under .claude/skills/ ARE committed -
# they ship with the project - but local overrides are personal.
.claude/settings.local.json

# Generated by vocab.py from whichever library this checkout points at, so it is
# per-user data rather than part of the project. Regenerate with `python3 vocab.py`.
# The retired-terms block inside it is hand-maintained and survives regeneration,
# so keep a copy if you care about it.
.claude/skills/zotero-tag/references/vocabulary.md

# Python
__pycache__/
*.py[cod]

# Never commit credentials. The Zotero API key lives in
# ~/.config/zotero-api.conf, outside this repo, and must stay there.
*.conf
.env
